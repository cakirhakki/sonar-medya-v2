APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:sU3wAFUkyQI9JAzwX0rGUxLCx+Wcsl/mI8c2tJZqFxg=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

# --- Logs ---
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database: in-memory SQLite (süper hızlı) ---
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# --- Caching / Queue / Session (test dostu sürücüler) ---
CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

# --- Filesystem ---
FILESYSTEM_DISK=public
# Not: Testlerde genellikle Storage::fake('public') kullanacağız.

# --- Mail (gerçek gönderim yok) ---
MAIL_MAILER=array
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Bu projeye özel (Breeze'i Customer ile çalıştırıyoruz) ---
AUTH_GUARD=customer
AUTH_PASSWORD_BROKER=customers

VITE_APP_NAME="${APP_NAME}"

# (Opsiyonel) SMS testleri için placeholderlar:
NETGSM_USER=
NETGSM_PASSWORD=
NETGSM_HEADER=BTTSRM
